// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`/dev/kit rendering > matches the snapshot 1`] = `"<section class="kit-section" aria-labelledby="kit-colour-tokens"><h2 id="kit-colour-tokens">Colour tokens</h2><p class="muted">Every colour on the site is one of these. The brand colour is for key actions and the logo.</p><div class="kit-panes"><div class="kit-pane" data-scheme="light"><p class="kit-pane-label">Light</p><div class="kit-group"><p class="kit-group-name">Page</p><ul class="kit-swatches"><li><i style="background:var(--canvas)" aria-hidden="true"></i><code>--canvas</code></li><li><i style="background:var(--surface)" aria-hidden="true"></i><code>--surface</code></li><li><i style="background:var(--surface-2)" aria-hidden="true"></i><code>--surface-2</code></li><li><i style="background:var(--line)" aria-hidden="true"></i><code>--line</code></li><li><i style="background:var(--line-strong)" aria-hidden="true"></i><code>--line-strong</code></li><li><i style="background:var(--ink)" aria-hidden="true"></i><code>--ink</code></li><li><i style="background:var(--ink-soft)" aria-hidden="true"></i><code>--ink-soft</code></li></ul></div><div class="kit-group"><p class="kit-group-name">Brand (key actions and the logo only)</p><ul class="kit-swatches"><li><i style="background:var(--brand)" aria-hidden="true"></i><code>--brand</code></li><li><i style="background:var(--brand-ink)" aria-hidden="true"></i><code>--brand-ink</code></li><li><i style="background:var(--brand-text)" aria-hidden="true"></i><code>--brand-text</code></li><li><i style="background:var(--brand-wash)" aria-hidden="true"></i><code>--brand-wash</code></li><li><i style="background:var(--highlight)" aria-hidden="true"></i><code>--highlight</code></li></ul></div><div class="kit-group"><p class="kit-group-name">Meaning</p><ul class="kit-swatches"><li><i style="background:var(--marigold)" aria-hidden="true"></i><code>--marigold</code></li><li><i style="background:var(--rose)" aria-hidden="true"></i><code>--rose</code></li><li><i style="background:var(--help-bg)" aria-hidden="true"></i><code>--help-bg</code></li><li><i style="background:var(--stage-1-t)" aria-hidden="true"></i><code>--stage-1-t</code></li><li><i style="background:var(--stage-2-t)" aria-hidden="true"></i><code>--stage-2-t</code></li><li><i style="background:var(--stage-3-t)" aria-hidden="true"></i><code>--stage-3-t</code></li><li><i style="background:var(--stage-4-t)" aria-hidden="true"></i><code>--stage-4-t</code></li></ul></div></div><div class="kit-pane" data-scheme="dark"><p class="kit-pane-label">Dark</p><div class="kit-group"><p class="kit-group-name">Page</p><ul class="kit-swatches"><li><i style="background:var(--canvas)" aria-hidden="true"></i><code>--canvas</code></li><li><i style="background:var(--surface)" aria-hidden="true"></i><code>--surface</code></li><li><i style="background:var(--surface-2)" aria-hidden="true"></i><code>--surface-2</code></li><li><i style="background:var(--line)" aria-hidden="true"></i><code>--line</code></li><li><i style="background:var(--line-strong)" aria-hidden="true"></i><code>--line-strong</code></li><li><i style="background:var(--ink)" aria-hidden="true"></i><code>--ink</code></li><li><i style="background:var(--ink-soft)" aria-hidden="true"></i><code>--ink-soft</code></li></ul></div><div class="kit-group"><p class="kit-group-name">Brand (key actions and the logo only)</p><ul class="kit-swatches"><li><i style="background:var(--brand)" aria-hidden="true"></i><code>--brand</code></li><li><i style="background:var(--brand-ink)" aria-hidden="true"></i><code>--brand-ink</code></li><li><i style="background:var(--brand-text)" aria-hidden="true"></i><code>--brand-text</code></li><li><i style="background:var(--brand-wash)" aria-hidden="true"></i><code>--brand-wash</code></li><li><i style="background:var(--highlight)" aria-hidden="true"></i><code>--highlight</code></li></ul></div><div class="kit-group"><p class="kit-group-name">Meaning</p><ul class="kit-swatches"><li><i style="background:var(--marigold)" aria-hidden="true"></i><code>--marigold</code></li><li><i style="background:var(--rose)" aria-hidden="true"></i><code>--rose</code></li><li><i style="background:var(--help-bg)" aria-hidden="true"></i><code>--help-bg</code></li><li><i style="background:var(--stage-1-t)" aria-hidden="true"></i><code>--stage-1-t</code></li><li><i style="background:var(--stage-2-t)" aria-hidden="true"></i><code>--stage-2-t</code></li><li><i style="background:var(--stage-3-t)" aria-hidden="true"></i><code>--stage-3-t</code></li><li><i style="background:var(--stage-4-t)" aria-hidden="true"></i><code>--stage-4-t</code></li></ul></div></div></div></section><section class="kit-section" aria-labelledby="kit-type"><h2 id="kit-type">Type</h2><p class="muted">Sans for Akana&#x27;s voice, serif for content. Akana Sans and Literata in this direction.</p><div class="kit-panes"><div class="kit-pane" data-scheme="light"><p class="kit-pane-label">Light</p><div class="kit-type"><p class="kit-sans-h">Interface heading in the sans</p><p class="kit-sans">Buttons, prompts and navigation use the sans at 16px.</p><p class="kit-serif-h">Book titles and content in the serif</p><p class="kit-serif">Workbook text is set at the reading size, 20px at step one, on a 65 character line. It grows with the reader&#x27;s text setting.</p><p class="kit-serif"><em>Quotes and book titles are in italic.</em></p></div></div><div class="kit-pane" data-scheme="dark"><p class="kit-pane-label">Dark</p><div class="kit-type"><p class="kit-sans-h">Interface heading in the sans</p><p class="kit-sans">Buttons, prompts and navigation use the sans at 16px.</p><p class="kit-serif-h">Book titles and content in the serif</p><p class="kit-serif">Workbook text is set at the reading size, 20px at step one, on a 65 character line. It grows with the reader&#x27;s text setting.</p><p class="kit-serif"><em>Quotes and book titles are in italic.</em></p></div></div></div></section><section class="kit-section" aria-labelledby="kit-buttons"><h2 id="kit-buttons">Buttons</h2><p class="muted">Default, secondary, help, disabled and keyboard focus.</p><div class="kit-panes"><div class="kit-pane" data-scheme="light"><p class="kit-pane-label">Light</p><div class="kit-row"><a class="btn" href="#kit">Primary</a><a class="btn secondary" href="#kit">Secondary</a><a class="btn help" href="#kit">Get help now</a><button type="button" class="btn" disabled="">Disabled</button><a class="btn kit-focus" href="#kit">Focus</a></div></div><div class="kit-pane" data-scheme="dark"><p class="kit-pane-label">Dark</p><div class="kit-row"><a class="btn" href="#kit">Primary</a><a class="btn secondary" href="#kit">Secondary</a><a class="btn help" href="#kit">Get help now</a><button type="button" class="btn" disabled="">Disabled</button><a class="btn kit-focus" href="#kit">Focus</a></div></div></div></section><section class="kit-section" aria-labelledby="kit-badges-and-cards"><h2 id="kit-badges-and-cards">Badges and cards</h2><div class="kit-panes"><div class="kit-pane" data-scheme="light"><p class="kit-pane-label">Light</p><div class="kit-stack"><div class="kit-row"><span class="badge">Included</span><span class="badge demo">Demo</span></div><div class="card"><p>A plain card on the surface colour.</p></div><a class="card lift" href="#kit"><p>A card that lifts on hover and focus.</p></a></div></div><div class="kit-pane" data-scheme="dark"><p class="kit-pane-label">Dark</p><div class="kit-stack"><div class="kit-row"><span class="badge">Included</span><span class="badge demo">Demo</span></div><div class="card"><p>A plain card on the surface colour.</p></div><a class="card lift" href="#kit"><p>A card that lifts on hover and focus.</p></a></div></div></div></section><section class="kit-section" aria-labelledby="kit-form-fields"><h2 id="kit-form-fields">Form fields</h2><p class="muted">Default, focus, error and disabled.</p><div class="kit-panes"><div class="kit-pane" data-scheme="light"><p class="kit-pane-label">Light</p><form class="kit-stack" aria-label="Sample fields"><label class="kit-field">Default<input class="ak-input" value="Some words"/></label><label class="kit-field">Focus<input class="ak-input kit-focus" value="Some words"/></label><label class="kit-field">Error<input class="ak-input" aria-invalid="true" value=""/><span class="kit-error">Say a little more.</span></label><label class="kit-field">Disabled<input class="ak-input" disabled="" value="Not editable"/></label><label class="kit-field">Longer answer<textarea class="ak-textarea" rows="3">A longer answer in the reading serif.</textarea></label></form></div><div class="kit-pane" data-scheme="dark"><p class="kit-pane-label">Dark</p><form class="kit-stack" aria-label="Sample fields"><label class="kit-field">Default<input class="ak-input" value="Some words"/></label><label class="kit-field">Focus<input class="ak-input kit-focus" value="Some words"/></label><label class="kit-field">Error<input class="ak-input" aria-invalid="true" value=""/><span class="kit-error">Say a little more.</span></label><label class="kit-field">Disabled<input class="ak-input" disabled="" value="Not editable"/></label><label class="kit-field">Longer answer<textarea class="ak-textarea" rows="3">A longer answer in the reading serif.</textarea></label></form></div></div></section><section class="kit-section" aria-labelledby="kit-shelves"><h2 id="kit-shelves">Shelves</h2><p class="muted">Ten shelves, each with a colour, an icon and a line.</p><div class="kit-panes"><div class="kit-pane" data-scheme="light"><p class="kit-pane-label">Light</p><div class="kit-tiles"><a class="shelf-tile" style="--shelf-tint:var(--shelf-mind-and-mood-t);--shelf-accent:var(--shelf-mind-and-mood-i)" href="/shelves/mind-and-mood"><svg class="shelf-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4a5 5 0 0 0-5 5c0 2 1 3 1 5h8c0-2 1-3 1-5a5 5 0 0 0-5-5Z"></path><path d="M9.5 18h5"></path><path d="M10.5 20.5h3"></path></svg><span class="shelf-tile-name">Mind and mood</span><span class="shelf-tile-line">Worry, mood, stress and getting through hard weeks.</span><span class="shelf-tile-count">12 titles</span></a><a class="shelf-tile" style="--shelf-tint:var(--shelf-work-and-career-t);--shelf-accent:var(--shelf-work-and-career-i)" href="/shelves/work-and-career"><svg class="shelf-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 8h16v11H4Z"></path><path d="M9 8V5.5h6V8"></path><path d="M4 13h16"></path></svg><span class="shelf-tile-name">Work and career</span><span class="shelf-tile-line">Careers, teams, ventures and doing good work.</span><span class="shelf-tile-count">12 titles</span></a><a class="shelf-tile" style="--shelf-tint:var(--shelf-money-t);--shelf-accent:var(--shelf-money-i)" href="/shelves/money"><svg class="shelf-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3.5v17"></path><path d="M16 7.5c0-1.4-1.8-2.5-4-2.5s-4 1.1-4 2.5 1.8 2.3 4 2.8 4 1.3 4 2.7-1.8 2.5-4 2.5-4-1.1-4-2.5"></path></svg><span class="shelf-tile-name">Money</span><span class="shelf-tile-line">Spending, saving, debt and a calmer view of money.</span><span class="shelf-tile-count">12 titles</span></a><a class="shelf-tile" style="--shelf-tint:var(--shelf-family-and-parenting-t);--shelf-accent:var(--shelf-family-and-parenting-i)" href="/shelves/family-and-parenting"><svg class="shelf-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 11.5 12 5l8 6.5"></path><path d="M6 10.5V19h12v-8.5"></path><path d="M10 19v-4.5h4V19"></path></svg><span class="shelf-tile-name">Family and parenting</span><span class="shelf-tile-line">Home, children and the people closest to you.</span><span class="shelf-tile-count">12 titles</span></a><a class="shelf-tile" style="--shelf-tint:var(--shelf-love-and-relationships-t);--shelf-accent:var(--shelf-love-and-relationships-i)" href="/shelves/love-and-relationships"><svg class="shelf-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19.5s-7-4.3-7-9.2A3.9 3.9 0 0 1 12 8a3.9 3.9 0 0 1 7 2.3c0 4.9-7 9.2-7 9.2Z"></path></svg><span class="shelf-tile-name">Love and relationships</span><span class="shelf-tile-line">Partners, friendships and being understood.</span><span class="shelf-tile-count">12 titles</span></a><a class="shelf-tile" style="--shelf-tint:var(--shelf-personal-growth-t);--shelf-accent:var(--shelf-personal-growth-i)" href="/shelves/personal-growth"><svg class="shelf-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20v-8"></path><path d="M12 12c0-3.5-2.5-5.5-6-5.5 0 3.5 2.5 5.5 6 5.5Z"></path><path d="M12 14c0-3 2.2-5 5.5-5 0 3-2.2 5-5.5 5Z"></path></svg><span class="shelf-tile-name">Personal growth</span><span class="shelf-tile-line">Habits, confidence and becoming who you mean to be.</span><span class="shelf-tile-count">12 titles</span></a><a class="shelf-tile" style="--shelf-tint:var(--shelf-learning-and-skills-t);--shelf-accent:var(--shelf-learning-and-skills-i)" href="/shelves/learning-and-skills"><svg class="shelf-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9.5 12 5l9 4.5-9 4.5Z"></path><path d="M7 12v4.5c1.2 1.2 3 2 5 2s3.8-.8 5-2V12"></path></svg><span class="shelf-tile-name">Learning and skills</span><span class="shelf-tile-line">Study, memory and picking up something new.</span><span class="shelf-tile-count">12 titles</span></a><a class="shelf-tile" style="--shelf-tint:var(--shelf-health-and-body-t);--shelf-accent:var(--shelf-health-and-body-i)" href="/shelves/health-and-body"><svg class="shelf-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 7a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"></path><path d="M12 8v6"></path><path d="M7 10.5l5-2.5 5 2.5"></path><path d="M9 20l3-6 3 6"></path></svg><span class="shelf-tile-name">Health and body</span><span class="shelf-tile-line">Sleep, movement, food and looking after yourself.</span><span class="shelf-tile-count">12 titles</span></a><a class="shelf-tile" style="--shelf-tint:var(--shelf-faith-and-spirituality-t);--shelf-accent:var(--shelf-faith-and-spirituality-i)" href="/shelves/faith-and-spirituality"><svg class="shelf-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4c1.5 3.5 4.5 5 4.5 8.5a4.5 4.5 0 0 1-9 0C7.5 9 10.5 7.5 12 4Z"></path><path d="M12 21v-3"></path></svg><span class="shelf-tile-name">Faith and spirituality</span><span class="shelf-tile-line">Prayer, reflection and a settled inner life.</span><span class="shelf-tile-count">12 titles</span></a><a class="shelf-tile" style="--shelf-tint:var(--shelf-creativity-and-making-t);--shelf-accent:var(--shelf-creativity-and-making-i)" href="/shelves/creativity-and-making"><svg class="shelf-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20l1-4 10-10 3 3-10 10Z"></path><path d="M13.5 7.5l3 3"></path></svg><span class="shelf-tile-name">Creativity and making</span><span class="shelf-tile-line">Writing, making and finding time for it.</span><span class="shelf-tile-count">12 titles</span></a></div></div><div class="kit-pane" data-scheme="dark"><p class="kit-pane-label">Dark</p><div class="kit-tiles"><a class="shelf-tile" style="--shelf-tint:var(--shelf-mind-and-mood-t);--shelf-accent:var(--shelf-mind-and-mood-i)" href="/shelves/mind-and-mood"><svg class="shelf-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4a5 5 0 0 0-5 5c0 2 1 3 1 5h8c0-2 1-3 1-5a5 5 0 0 0-5-5Z"></path><path d="M9.5 18h5"></path><path d="M10.5 20.5h3"></path></svg><span class="shelf-tile-name">Mind and mood</span><span class="shelf-tile-line">Worry, mood, stress and getting through hard weeks.</span><span class="shelf-tile-count">12 titles</span></a><a class="shelf-tile" style="--shelf-tint:var(--shelf-work-and-career-t);--shelf-accent:var(--shelf-work-and-career-i)" href="/shelves/work-and-career"><svg class="shelf-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 8h16v11H4Z"></path><path d="M9 8V5.5h6V8"></path><path d="M4 13h16"></path></svg><span class="shelf-tile-name">Work and career</span><span class="shelf-tile-line">Careers, teams, ventures and doing good work.</span><span class="shelf-tile-count">12 titles</span></a><a class="shelf-tile" style="--shelf-tint:var(--shelf-money-t);--shelf-accent:var(--shelf-money-i)" href="/shelves/money"><svg class="shelf-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3.5v17"></path><path d="M16 7.5c0-1.4-1.8-2.5-4-2.5s-4 1.1-4 2.5 1.8 2.3 4 2.8 4 1.3 4 2.7-1.8 2.5-4 2.5-4-1.1-4-2.5"></path></svg><span class="shelf-tile-name">Money</span><span class="shelf-tile-line">Spending, s