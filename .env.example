# Copy to apps/web/.env.local for local work. Never commit real values.
# Crent adds production values in Vercel himself. Agents never see the service role key.

NEXT_PUBLIC_SUPABASE_URL=https://suiuyolccgyjglfwgwnw.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Answer sealing key ring. Format: v2.<key_id>.<base64 32 bytes>. Several keys separated by commas.
# Generate one with: pnpm tsx scripts/new-seal-key.ts
ANSWERS_KEYS=

# Stripe. Use TEST MODE keys (sk_test_...) everywhere until the live_payments
# flag and the gates in AK_3_Week_Plan section 7 are cleared; Crent adds live
# keys in Vercel himself. The platform webhook endpoint is POST /api/stripe/webhook
# (events: checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, charge.refunded, and for membership
# customer.subscription.created, customer.subscription.updated,
# customer.subscription.deleted, invoice.paid, invoice.payment_failed). STRIPE_WEBHOOK_SECRET
# is that endpoint's signing secret (whsec_...), or the one `stripe listen
# --forward-to localhost:3000/api/stripe/webhook` prints for local work.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Connect payouts (F-099): a second webhook endpoint in Stripe, set to "events
# on Connected accounts", pointing at the same URL POST /api/stripe/webhook,
# with account.updated and account.external_account.created, .updated and
# .deleted. Its signing secret goes here. Onboarding returns to /payouts/return.
STRIPE_CONNECT_WEBHOOK_SECRET=
# Royalty ledger (M6, migration 0021). No new variables. The platform
# webhook endpoint above also needs charge.dispute.created and
# charge.dispute.closed so disputes reverse and restore the author's share.
# Two daily crons use CRON_SECRET: /api/money/daily (reconcile with Stripe
# balance transactions, close due pool months and statements) and
# /api/money/payout-run (acts only on the payout day in royalty_config).
# Payout runs, approvals and transfer reversals refuse to run unless
# STRIPE_SECRET_KEY is a test key (sk_test_ or rk_test_). Livemode for the
# ledger pages follows the same key.
# CRON_SECRET: the shared secret Vercel Cron sends as a Bearer token to every
# cron route in apps/web/vercel.json. Generate with: openssl rand -hex 32
CRON_SECRET=
# Membership (F-097). PLACEHOLDER until Crent sets the prices (C4, D1 to D4).
# The ids of two recurring prices on the "Akana membership" product (never a
# title), tax behaviour inclusive. While unset, membership checkout says
# "not open yet". Keep public.price_points member_month / member_year in step.
STRIPE_PRICE_MEMBERSHIP_MONTHLY=
STRIPE_PRICE_MEMBERSHIP_YEARLY=
# Akana for organisations billing (F-220, F-226, migration 0030). TEST MODE
# ONLY: every organisation Stripe call refuses unless STRIPE_SECRET_KEY is a
# test key. PLACEHOLDER until Crent sets organisation prices (N2): the app
# shows no figures, and a plan whose price id is unset says "Talk to us".
# Recurring prices on an "Akana for organisations" product (never a title),
# licensed usage, tax behaviour as Crent decides. Per seat (quantity = seats):
STRIPE_PRICE_ORG_SEAT_MONTHLY=
STRIPE_PRICE_ORG_SEAT_YEARLY=
# Group plans, per member, monthly:
STRIPE_PRICE_ORG_GROUP_MEMBER_MONTHLY=
# Church bands, quantity 1 each (the church offer waits for F-215 and F-221):
STRIPE_PRICE_ORG_CHURCH_BAND_1=
STRIPE_PRICE_ORG_CHURCH_BAND_2=
STRIPE_PRICE_ORG_CHURCH_BAND_3=
# The platform webhook endpoint above also needs, for organisation billing:
# invoice.finalized, invoice.sent, invoice.updated, invoice.voided,
# invoice.marked_uncollectible and invoice.overdue (subscription, paid and
# failed events are already listed). Events are told apart by Stripe metadata
# akana_kind = org_licence or org_signup. Self-serve sign-up (F-226) also needs
# the org_self_serve feature flag on (public.feature_flags, seeded off); it
# stays off until the prices are set. The daily /api/ops/sweep deletes an
# organisation's roster and admin details 30 days after its last licence ends.

# Without RESEND_API_KEY the mailer records sends in a dev transport and sends nothing.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
# "live" sends to real recipients. Anything else sends to TEST_RECIPIENT with a [Test] subject.
EMAIL_MODE=test
TEST_RECIPIENT=
# The mailer refuses marketing and progress mail while this is a placeholder.
POSTAL_ADDRESS=PLACEHOLDER

# Library (F-003): a genre shelf stays hidden until it holds this many live
# titles. Crent sets the figure. Leave blank for the default of 3.
SHELF_MIN_COUNT=

# Enquiries from /publish (F-001). LEADS_NOTIFY_TO is the team address that
# receives a note when a lead arrives. Without it, or without RESEND_API_KEY,
# the notification goes to the dev transport and nothing is sent.
LEADS_NOTIFY_TO=
# Secret salt for hashing the IP address and user agent stored with a lead.
# The contact form and the notice and takedown form (/takedown) use it too.
# First-party analytics (0036) use the same salt for the daily visitor id:
# sha256(salt : UTC date : user id, or address and user agent). The id
# changes every day, is never shown, and the rows holding it are deleted the
# next day, so no profile can be built from it. No cookie is set for it.
# While blank: a fixed development salt is used outside production; in
# production lead forms refuse to submit, and analytics counts go in with no
# visitor id (so uniques read zero) and the gap is logged.
# Required in production; generate with: openssl rand -hex 32
LEAD_HASH_SALT=

# Host the marketplace runs on, and the separate apex for tenant subdomains.
# AKANA_HOST also sets the site origin for canonical links, the sitemap and
# robots.txt (https unless it is localhost), unless NEXT_PUBLIC_SITE_URL is set.
AKANA_HOST=localhost:3000
# Optional. The full public origin of the marketplace, for example
# https://akana.example. Wins over AKANA_HOST for metadataBase, canonical
# links, sitemap.xml and robots.txt (F-011). Leave blank to use AKANA_HOST.
NEXT_PUBLIC_SITE_URL=
TENANT_APEX=
# Optional (F-074). Extra hosts that serve the demo white-label site from
# config, comma separated, for example a Vercel alias pointed at a preview:
# akana-demo-site.vercel.app. demo.localhost always works locally, and
# demo.<TENANT_APEX> works once TENANT_APEX is set. No domain is registered.
DEMO_TENANT_HOSTS=
# Optional (migration 0033). The CNAME target shown to tenants for a custom
# domain at /admin/white-label/[id]. Blank means cname.vercel-dns.com. Set it
# to the project-specific target Vercel shows under Settings, Domains, if it
# shows one. Not a secret. Custom domain checks run daily at 06:29 UTC
# (/api/ops/domain-check, CRON_SECRET) and use Cloudflare DNS-over-HTTPS.
TENANT_CNAME_TARGET=

# Google One Tap (13.1). The OAuth web client id from the Google Cloud
# console, for example 1234-abc.apps.googleusercontent.com. Not a secret.
# While blank, the sign-in page shows the email link only, no Google script
# is loaded and the CSP never names accounts.google.com. When set, One Tap
# and a "Continue with Google" button appear on /sign-in (and the pages in
# ONE_TAP_PATHS, apps/web/csp.mjs), and only those pages allow Google's
# origin. The same client id must be in Supabase (Authentication, Providers,
# Google, "Authorized Client IDs") for signInWithIdToken to accept the
# token. Set-up steps: docs/AUTH.md.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Error tracking (10.3), Sentry. While both DSNs are blank nothing from
# Sentry loads: no SDK in the browser, no server hook, no change to the CSP.
# When set, errors go to the DSN's project with request bodies, cookies,
# query strings, emails and anything answer-like removed first
# (apps/web/lib/sentry-scrub.ts). The DSN's origin is added to connect-src.
# Use the same DSN for both; the public one is inlined into the browser
# bundle, which is how a DSN is meant to be used.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Session replay on error, 0 to 1 (share of error sessions recorded). Blank
# or 0 means no replays at all. Any replay masks every piece of text and
# blocks every image and video. The privacy notice says "no session
# recording", so leave this blank unless that wording is changed first.
NEXT_PUBLIC_SENTRY_REPLAY_ON_ERROR=
# Source map upload at build time, optional. Blank means no upload and no
# Sentry CLI call; errors still arrive, with minified stack traces.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Operational alerts (F-142). One email when an alert opens: a webhook,
# scheduled job, payout or validator failure, email failures above a
# threshold, or an error spike. Goes to OPS_ALERT_TO, or to LEADS_NOTIFY_TO
# when OPS_ALERT_TO is blank. Staff see alerts at /admin/ops. Sentry (above)
# is the only outside error tracker, and only while its DSN is set.
OPS_ALERT_TO=

# Workbook comment thread (F-039, migration 0027). When an author posts and
# no reviewer is assigned to the workbook yet, the "new comment" email (no
# comment text) goes to this team inbox, or to LEADS_NOTIFY_TO when blank.
REVIEW_NOTIFY_TO=
